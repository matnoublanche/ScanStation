def event(args, name, **fields):
    if args.json:
        print(json.dumps({"event": name, **fields}, ensure_ascii=False), flush=True)
    else:
        print(name, *fields.values(), flush=True)


def scanner_device(configured):
    if configured != "auto":
        return configured
    devices = subprocess.check_output(["scanimage", "-f", "%d%n"], text=True).splitlines()
    matches = [d for d in devices if d.startswith("epjitsu:")]
    if len(matches) != 1:
        raise ValueError("Specify --device when discovery does not find exactly one epjitsu scanner.")
    return matches[0]


def fold_traces_only(contrast):
    """Identify narrow continuous folds across an otherwise bright page."""
    for values in (contrast, contrast.T):
        rows = np.flatnonzero((values > 84).any(axis=1))
        if not rows.size:
            continue
        groups = np.split(rows, np.flatnonzero(np.diff(rows) > 1) + 1)
        if len(groups) > 4:
            continue
        for group in groups:
            if len(group) > 4:
                break
            strip = values[max(0, group[0]-3):group[-1]+4]
            # An isolated mark, QR code or text does not span the page
            # continuously within such a thin band.
            if (strip.max(axis=0) > 30).mean() < .85:
                break
            if np.quantile((strip > 45).sum(axis=0), .9) > 4:
                break
        else:
            return True
    return False


def inspect_page(im, back=False):
    # Use the darkest channel to protect colored marks.
    r, g, b = im.convert("RGB").split()
    ink = ImageChops.darker(ImageChops.darker(r, g), b)
    small = ink.resize((max(1, ink.width // 3), max(1, ink.height // 3)),
                       Image.Resampling.BOX)
    hist = im.convert("L").resize(small.size, Image.Resampling.BOX).histogram()
    bright = sum(hist[210:]) / (small.width * small.height)
    # Local contrast protects small dark marks.
    background = small.filter(ImageFilter.MaxFilter(7))
    contrast = ImageChops.subtract(background, small)
    local = contrast.filter(ImageFilter.BoxBlur(1))
    peak = local.getextrema()[1]
    margin = 30  # About 7.6 mm at 100 dpi.
    if min(local.size) <= 2 * margin:
        return False, round(bright, 5), peak
    inner = local.crop((margin, margin, local.width - margin, local.height - margin))
    blank = bright >= 0.94 and peak <= 132 and inner.getextrema()[1] <= 84
    if not blank and back and bright >= .94 and peak <= 132:
        blank = fold_traces_only(np.asarray(inner))
    return blank, round(bright, 5), peak


def verify(directory, args):
    expected = [False, True, False, False]
    actual = []
    for n in range(1, 5):
        name = directory / f"page-{n:03}.pnm"
        with Image.open(name) as im:
            paper, _, _ = paper_area(im)
            blank, bright, peak = inspect_page(paper, back=n % 2 == 0)
            if blank and peak >= 45 and blank_has_text(paper):
                blank = False
        actual.append(blank)
        event(args, "reference", file=name.name, kept=not blank, bright_fraction=bright, contrast=peak)
    if actual != expected:
        raise ValueError("Reference check failed. Use --no-filter to keep all sides.")


def pages(directory):
    found = sorted((int(m[1]), p) for p in directory.iterdir()
                   if (m := re.fullmatch(r"page-(\d+)\.pnm", p.name)))
    if not found or [n for n, _ in found] != list(range(1, len(found) + 1)):
        raise ValueError(f"Empty batch or nonconsecutive page numbers in {directory}")
    if len(found) % 2:
        raise ValueError(f"Odd number of sides in {directory}. Check duplex capture.")
    return [p for _, p in found]


def acquire(dest, device, args, pass_no):
    cmd = ["scanimage", "-d", device, "--source", "ADF Duplex", "--mode", "Color",
           "--resolution", "300", "--page-height", "0", "--format=pnm", "--batch=page-%06d.pnm"]
    with subprocess.Popen(cmd, cwd=dest, stderr=subprocess.PIPE, text=True,
                          env={**os.environ, "LC_ALL": "C"}) as result:
        for line in result.stderr:
            print(line, end="", file=sys.stderr, flush=True)
            match = re.match(r"Scanned page (\d+) ", line)
            if match:
                event(args, "progress", stage="captured", pass_number=pass_no,
                      side=int(match[1]), total_sides=None)
        result.wait()
    # SANE_STATUS_NO_DOCS (7) is expected at the end of the feeder.
    if result.returncode not in (0, 7):
        raise ValueError(f"Capture interrupted (scanimage {result.returncode}).")
    return pages(dest)


def edge_line(gray, reverse=False):
    """Fit the boundary between the gray feeder and the paper at multiple heights."""
    width, height = gray.size
    ys = np.linspace(height * .04, height * .96, 101).astype(int)
    depth = min(width // 20, 130)
    if depth < 12:
        return None
    strip = np.asarray(gray)[:, ::-1] if reverse else np.asarray(gray)
    samples = np.median(strip[ys[:, None] + np.arange(-2, 3), :depth], axis=1)
    steps = samples[:, 6:] - samples[:, :-6]
    xs = steps.argmax(axis=1) + 3
    valid = (steps.max(axis=1) >= 22) & (samples[:, :2].mean(axis=1) < 205)
    if valid.sum() < 42:
        return None
    xs, ys = xs[valid], ys[valid]
    best = np.zeros(len(xs), dtype=bool)
    for i in range(0, len(xs), 4):
        for j in range(i + 1, len(xs), 4):
            if ys[j] - ys[i] < height * .25:
                continue
            slope = (xs[j] - xs[i]) / (ys[j] - ys[i])
            if abs(slope) > .06:
                continue
            agree = abs(xs - xs[i] - slope * (ys - ys[i])) < 4
            if agree.sum() > best.sum():
                best = agree
    if best.sum() < 42 or np.ptp(ys[best]) < height * .52:
        return None
    slope, intercept = np.polyfit(ys[best], xs[best], 1)
    if reverse:
        return -slope, width - intercept
    return slope, intercept


def straighten(im):
    gray = im.convert("L")
    left = edge_line(gray)
    right = edge_line(gray, True)
    lines = [line for line in (left, right) if line is not None]
    if not lines or (len(lines) == 2 and abs(left[0] - right[0]) > .006):
        return im.copy(), 0.0
    slope = float(np.mean([line[0] for line in lines]))
    w, h = im.size
    # Use deskewed coordinates and retain the full page height.
    lo = left[1] + 2 if left else min(0, -slope*h)
    hi = right[1] - 2 if right else max(w, w - slope*h)
    top = min(0, slope*w)
    scale = 1 + slope*slope
    matrix = (1/scale, slope/scale, (lo+slope*top)/scale,
              -slope/scale, 1/scale, (top-slope*lo)/scale)
    size = (int(np.ceil(hi-lo)), int(np.ceil(h+abs(slope*w))))
    result = im.transform(size, Image.Transform.AFFINE, matrix,
                          Image.Resampling.BICUBIC, fillcolor="white")
    return result, round(float(np.degrees(np.arctan(slope))), 3)


def feeder_edge(gray):
    """Fit the transition from the feeder backing to paper across the width."""
    h, w = gray.shape
    depth = min(h // 9, 380)
    if depth < 20 or w < 100:
        return None
    xs = np.linspace(w*.04, w*.96, 81).astype(int)
    profiles = np.median(gray[:depth, xs[:, None] + np.arange(-2, 3)], axis=2)
    hits = []
    for x, column in zip(xs, profiles.T):
        # Ignore white wedges added by deskew. Require a run of neutral backing
        # followed by a sustained rise onto paper, allowing a dark edge shadow.
        backing = (column >= 105) & (column <= 198)
        starts = np.flatnonzero(np.convolve(backing.astype(int), np.ones(5), 'valid') == 5)
        if not starts.size or starts[0] > 45 or np.any(column[:starts[0]] < 100):
            continue
        start = starts[0]
        baseline = np.median(column[start:start+5])
        light = column > max(197, baseline + 19)
        ends = np.flatnonzero(np.convolve(light.astype(int), np.ones(5), 'valid') == 5)
        ends = ends[ends >= start+5]
        if ends.size and backing[start:ends[0]].mean() >= .58:
            hits.append((x, ends[0]))
    if len(hits) < len(xs)*.60:
        return None
    x, y = np.asarray(hits).T
    # Median of widely separated pair slopes rejects isolated printed marks.
    dx = x[None, :] - x[:, None]
    wide = dx > w*.3
    if not wide.any():
        return None
    slope = np.median((y[None, :] - y[:, None])[wide] / dx[wide])
    intercept = np.median(y - slope*x)
    good = abs(y - slope*x - intercept) < 5
    if good.sum() < len(xs)*.58 or np.ptp(x[good]) < w*.70 or abs(slope) > .075:
        return None
    slope, intercept = np.polyfit(x[good], y[good], 1)
    return np.clip(np.ceil(intercept + slope*np.arange(w)+1), 0, depth).astype(int)


def paper_area(im):
    aligned, skew = straighten(im.convert("RGB"))
    gray = np.asarray(aligned.convert("L"))
    pixels = np.array(aligned)
    cuts = []
    for rows, rgb in ((gray, pixels), (gray[::-1], pixels[::-1])):
        edge = feeder_edge(rows)
        if edge is None:
            cuts.append(0)
            continue
        depth = int(edge.max())
        rgb[:depth][np.arange(depth)[:, None] < edge] = 255
        cuts.append(int(edge.min()))
    return Image.fromarray(pixels[cuts[0]:len(pixels)-cuts[1]]), skew, cuts


def orientation(path, fallback, min_score=8):
    proc = subprocess.run(["tesseract", str(path), "stdout", "--dpi", "300",
                           "-l", "osd", "--psm", "0"], capture_output=True, text=True,
                          env={**os.environ, "LC_ALL": "C"})
    angle = re.search(r"^Rotate: (0|90|180|270)$", proc.stdout, re.M)
    score = re.search(r"^Orientation confidence: ([\d.]+)", proc.stdout, re.M)
    if proc.returncode == 0 and angle and score and float(score[1]) >= min_score:
        return int(angle[1]), "detected"
    return fallback, "fallback"


def clean_document(im, directory):
    """Clean luminance with Leptonica before choosing color or grayscale."""
    im = im.resize(tuple(max(1, round(v * 2 / 3)) for v in im.size),
                   Image.Resampling.LANCZOS)
    gray = im.convert("L")
    lib = ctypes.CDLL("libleptonica.so.6")
    ptr = ctypes.c_void_p
    lib.pixRead.argtypes = [ctypes.c_char_p]
    lib.pixRead.restype = ptr
    lib.pixCleanBackgroundToWhite.argtypes = [ptr, ptr, ptr, ctypes.c_float,
                                             ctypes.c_int, ctypes.c_int]
    lib.pixCleanBackgroundToWhite.restype = ptr
    lib.pixWrite.argtypes = [ctypes.c_char_p, ptr, ctypes.c_int]
    lib.pixDestroy.argtypes = [ctypes.POINTER(ptr)]
    with tempfile.TemporaryDirectory(dir=directory) as tmp:
        source = Path(tmp) / "gray.pgm"
        target = Path(tmp) / "clean.png"
        gray.save(source)
        raw = ptr(lib.pixRead(bytes(source)))
        clean = ptr()
        try:
            if raw:
                clean = ptr(lib.pixCleanBackgroundToWhite(raw, None, None, 1., 30, 185))
            if not clean or lib.pixWrite(bytes(target), clean, 3):
                raise ValueError("Leptonica background cleanup failed")
            with Image.open(target) as result:
                local = np.asarray(result, dtype=np.float32)
        finally:
            lib.pixDestroy(ctypes.byref(raw))
            lib.pixDestroy(ctypes.byref(clean))

    rgb = np.asarray(im, dtype=np.float32)
    lum = np.asarray(gray, dtype=np.float32)
    fixed = np.clip((rgb - 27) * (255 / 180), 0, 255)
    adjusted = np.clip(rgb + (local - lum)[:, :, None] + 3, 0, 255)
    pixels = np.minimum(adjusted, fixed).astype(np.uint8)
    neutral = np.ptp(rgb, axis=2) < 23
    pixels[neutral] = np.minimum(local, fixed.mean(axis=2))[neutral, None]
    chroma = np.ptp(pixels, axis=2)
    fraction = float((chroma > 65).mean())
    is_color = fraction > .002
    page = Image.fromarray(pixels)
    if not is_color:
        page = page.convert("L")
    # Remove only long streaks parallel to the edge in the outer 4 mm.
    # Preserve isolated marks.
    for turn in range(4):
        band = np.asarray(page.convert("L"))[:32, :]
        dark_columns = band.min(axis=0) < 237
        for start, end in np.flatnonzero(np.diff(np.r_[False, dark_columns, False])).reshape(-1, 2):
            if end - start < page.width * .10:
                continue
            for x in range(start, end):
                depth = np.flatnonzero(band[:, x] < 244)
                if len(depth) and depth[-1] < len(band)-1:
                    page.paste("white", (int(x), 0, int(x+1), int(depth[-1]+2)))
        page = page.transpose(Image.Transpose.ROTATE_90)
    return ImageOps.expand(page, border=8, fill="white"), fraction


def receipt_area(im):
    gray = im.convert("L")
    a = np.asarray(gray)
    h, w = a.shape
    background = float(np.median(a[h//8:7*h//8:16, [w//50, w-w//50-1]]))
    threshold = min(204, max(170, background + 22))
    samples = []
    for y in np.linspace(h*.08, h*.92, 101).astype(int):
        xs = np.flatnonzero(a[y] > threshold)
        if xs.size > w*.10:
            samples.append((y, xs[0], xs[-1]))
    if len(samples) < 70:
        return paper_area(im)
    y, left, right = np.asarray(samples).T
    slope, intercept = np.polyfit(y, (left+right)/2, 1)
    widths = right-left
    if (abs(slope) > .25 or np.median(widths) > w*.91
            or np.quantile(abs(widths-np.median(widths)), .9) > w*.035
            or np.quantile(abs((left+right)/2 - (intercept+slope*y)), .9) > w*.025):
        return paper_area(im)
    degrees = float(-np.degrees(np.arctan(slope)))
    rot = gray.rotate(degrees, Image.Resampling.BICUBIC, expand=True, fillcolor=int(background))
    a = np.asarray(rot)
    samples = [np.flatnonzero(a[y] > threshold) for y in
               np.linspace(rot.height*.10, rot.height*.90, 101).astype(int)]
    bounds = [(row[0], row[-1]) for row in samples if row.size]
    l, r = np.median(bounds, axis=0).astype(int)
    l, r = max(0, l-4), min(rot.width, r+5)
    rows = np.flatnonzero((a[:, l+10:r-10] > threshold).mean(axis=1) > .25)
    if not rows.size:
        return paper_area(im)
    top, bottom = max(0, rows[0]-4), min(rot.height, rows[-1]+5)
    return rot.crop((l, top, r, bottom)), round(degrees, 3), [int(top), int(rot.height-bottom)]


def receipt_marks(im):
    gray = im.convert("L")
    small = gray.resize((max(1, gray.width//3), max(1, gray.height//3)), Image.Resampling.BOX)
    ink = ImageChops.subtract(small.filter(ImageFilter.MaxFilter(7)), small)
    smooth = np.asarray(ink.filter(ImageFilter.BoxBlur(1)))
    peak = smooth[4:-4, 4:-4].max() if min(smooth.shape) > 8 else 255
    layout = np.asarray(ink.resize((160, 640), Image.Resampling.BOX), dtype=np.float32)
    return layout, float(np.percentile(ink, 99)), int(peak), gray.size


def mirrored_receipt(front, back):
    """Register the mirrored front and veto unexplained marks on the back."""
    front_ink, strength, _, front_size = front
    back_ink, faint, peak, back_size = back
    if (strength < 20 or faint > strength*.65 or peak > 125 or
            any(abs(a-b) > .05*max(a, b) for a, b in zip(front_size, back_size))):
        return False
    target = back_ink[10:-10:2, 6:-6:2]
    centered = target - target.mean()
    norm = np.sqrt((centered**2).sum())
    if target.std() < 2:
        return False
    best = 0.
    for reflected in (front_ink[:, ::-1], front_ink[::-1, :]):
        for dy in range(-8, 9):
            for dx in range(-4, 5):
                view = reflected[10+dy:630+dy:2, 6+dx:154+dx:2]
                view = view - view.mean()
                score = (centered*view).sum() / max(1., norm*np.sqrt((view**2).sum()))
                if score > best:
                    best, match, shift = score, reflected, (dy, dx)
    if best < .55:
        return False
    # Allow small transport distortions. Outside the overlap, there is no
    # front-side ink that could explain a mark. Keep unmatched writing.
    dy, dx = shift
    padded = np.pad(match, ((8, 8), (4, 4)))
    aligned = padded[8+dy:648+dy, 4+dx:164+dx]
    nearby = np.asarray(Image.fromarray(aligned.astype("uint8")).filter(ImageFilter.MaxFilter(5)))
    residual = np.maximum(back_ink - (.65*nearby + 10), 0)
    # The outermost cells include the cut edge of the physical paper.
    evidence = residual[2:-2, 2:-2]
    patch_mean = np.asarray(Image.fromarray(evidence.astype("uint8")).filter(ImageFilter.BoxBlur(2)))
    return evidence.max() < 40 and patch_mean.max() < 20


def read_lines(image):
    """Read a preview into confident word groups. Never add an OCR layer."""
    stream = io.BytesIO()
    image.convert("L").save(stream, format="PPM")
    proc = subprocess.run(["tesseract", "stdin", "stdout", "--dpi", "250", "-l", "fra+eng",
                           "--psm", "11", "tsv"], input=stream.getvalue(),
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=45)
    if proc.returncode:
        raise ValueError("Text preview failed. Check the French and English Tesseract data.")
    lines = {}
    for row in csv.DictReader(io.StringIO(proc.stdout.decode()), delimiter="\t", quoting=csv.QUOTE_NONE):
        word = (row.get("text") or "").strip()
        if row["level"] == "5" and word and float(row["conf"]) >= 55:
            key = tuple(row[k] for k in ("block_num", "par_num", "line_num"))
            lines.setdefault(key, []).append((word, float(row["conf"])))
    return list(lines.values())


def header_lines(im):
    header = im.crop((0, 0, im.width, min(im.height, max(500, int(im.height*.34)), 1450)))
    header.thumbnail((1800, 1450))
    return read_lines(ImageOps.autocontrast(header.convert("L"), cutoff=(0, 1)))


def readability(lines):
    return sum(min(len(word), 12) for line in lines for word, confidence in line
               if confidence >= 75 and sum(c.isalpha() for c in word) >= 2)


def document_name(lines, receipt, fallback):
    text = [" ".join(word for word, conf in line) for line in lines]
    candidates = []
    for line, words in zip(text, lines):
        if len(line) > 85 or not 1 <= len(words) <= 10:
            continue
        if sum(c.isalpha() for c in line) < 4 or sum(c.isdigit() for c in line) > 2:
            continue
        if np.mean([conf for _, conf in words]) < 80:
            continue
        if re.search(r"@|https?://|\b(?:rue|avenue|tél|tel|siret|siren|tva|cedex|www)\b", line, re.I):
            continue
        safe = re.sub(r"[^\w -]+", " ", line, flags=re.UNICODE)
        safe = " ".join(safe.split())[:64].strip(" -_")
        if safe:
            candidates.append(safe)
    title = candidates[0] if candidates else fallback
    dates = set()
    for d, m, y in re.findall(r"\b(\d{1,2})[/.\-](\d{1,2})[/.\-](20\d\d)\b", " ".join(text)):
        try:
            dates.add(date(int(y), int(m), int(d)))
        except ValueError:
            continue
    stamp = dates.pop() if len(dates) == 1 else date.today()
    return f"{stamp.isoformat()} - {'Receipt - ' if receipt else ''}{title}"


def blank_has_text(im):
    # Recognition is a veto only. A missing OCR result cannot erase artwork.
    preview = im.convert("L")
    preview.thumbnail((1500, 1900))
    for angle in (0, 180):
        lines = read_lines(preview.rotate(angle))
        if any(sum(len(w) for w, c in line if c >= 85 and w.isalpha()) >= 5 for line in lines):
            return True
    return False


def run(args):
    if args.mode == "verify" and not args.reference:
        raise ValueError("Set --reference to the reference image directory.")
    if args.reference and (args.mode == "verify" or (args.replay and args.filter)):
        verify(args.reference, args)
    if args.mode == "verify":
        return
    if args.mode != "multipass" and len(args.replay) > 1:
        raise ValueError("Multiple replay directories require multipass mode.")
    if not args.replay:
        # The controller releases the sensor when the worker takes scanner.lock.
        lockdir = Path(os.environ.get("XDG_STATE_HOME") or Path.home()/".local/state") / "scanstation"
        with (lockdir / "device.lock").open("a") as gate:
            fcntl.flock(gate, fcntl.LOCK_EX)
            args.device = scanner_device(args.device)
    args.output.mkdir(parents=True, exist_ok=True)
    job = Path(tempfile.mkdtemp(prefix="scan-", dir=args.output)).resolve()
    event(args, "job", directory=str(job))
    pending = job / "pdf-pending"
    pending.mkdir()
    groups = []
    titles = {}
    final_names = []
    report = []
    pass_no = 0
    while True:
        pass_no += 1
        folder = job / f"pass-{pass_no:03}"
        folder.mkdir()
        event(args, "pass", number=pass_no)
        if args.replay:
            originals = []
            for p in pages(args.replay[pass_no - 1]):
                originals.append(Path(shutil.copy2(p, folder / p.name)))
        else:
            originals = acquire(folder, args.device, args, pass_no)
            if pass_no == 1 and args.reference and args.filter:
                verify(args.reference, args)
        for index, p in enumerate(originals):
            if not groups or (args.mode == "sheet" and index % 2 == 0):
                groups.append([])
            if index % 2 == 0:
                front_angle = 0
            position = dict(pass_number=pass_no, side=index+1, total_sides=len(originals),
                            document=len(groups), total_documents=None)
            event(args, "progress", stage="crop", **position)
            correction = {}
            lines = None
            with Image.open(p) as im:
                receipt = args.profile == "receipt"
                aligned, skew, cuts = receipt_area(im) if receipt else paper_area(im)
                correction["vertical_trim_px"] = cuts
                event(args, "progress", stage="filter", **position)
                blank, bright, peak = inspect_page(aligned, back=index % 2 == 1)
                if receipt:
                    marks = receipt_marks(aligned)
                    if index % 2 == 0:
                        front_marks = marks
                    elif blank and marks[2] > 40:
                        blank = False
                    if index % 2 and mirrored_receipt(front_marks, marks):
                        blank = True
                        correction["reason"] = "front-side show-through"
                if args.filter and blank and "reason" not in correction and peak >= 45:
                    event(args, "progress", stage="check_text", **position)
                    if blank_has_text(aligned):
                        blank = False
                        correction["reason"] = "readable text"
                kept = not (args.filter and blank)
                if kept:
                    event(args, "progress", stage="orient", **position)
                    jpg = p.with_suffix(".jpg")
                    if receipt:
                        with tempfile.TemporaryDirectory(dir=folder) as tmp:
                            cropped = Path(tmp) / "receipt.pgm"
                            aligned.convert("L").save(cropped)
                            angle, source = orientation(cropped, front_angle)
                            if source == "fallback":
                                # On thermal paper, confirm a weak orientation estimate
                                # by checking again after a half turn.
                                first, label = orientation(cropped, front_angle, min_score=1)
                                if label == "detected":
                                    aligned.convert("L").rotate(180).save(cropped)
                                    other, check = orientation(cropped, front_angle, min_score=1)
                                    if check == "detected" and (other+180) % 360 == first:
                                        angle, source = first, "cross-checked"
                    else:
                        angle, source = orientation(p, front_angle)
                    if receipt and source == "fallback":
                        alternatives = [(a, header_lines(aligned.rotate(-a, expand=True)))
                                        for a in (angle, (angle+180) % 360)]
                        alternatives.sort(key=lambda pair: readability(pair[1]), reverse=True)
                        best, other = alternatives
                        if readability(best[1]) >= max(18, readability(other[1])*1.5):
                            angle, lines = best
                            source = "header readability"
                    if index % 2 == 0:
                        front_angle = angle
                    correction.update(clockwise_rotation=angle, orientation=source, skew_degrees=skew)
                    upright = aligned.rotate(-angle, expand=True)
                    event(args, "progress", stage="clean", **position)
                    if receipt:
                        cleaned = ImageOps.autocontrast(upright.convert("L"), cutoff=(0, 1))
                        fraction = 0.0
                    else:
                        cleaned, fraction = clean_document(upright, folder)
                    correction.update(image_mode=cleaned.mode, color_fraction=fraction)
                    dpi = 300 if receipt else 200
                    cleaned.save(jpg, quality=args.quality, optimize=True, dpi=(dpi, dpi))
                    if args.auto_name and not groups[-1]:
                        event(args, "progress", stage="name", **position)
                        if lines is None:
                            lines = header_lines(upright)
                        titles[len(groups)] = document_name(lines, receipt, "Scan")
                    groups[-1].append(jpg)
            event(args, "side", pass_number=pass_no, number=index+1, kept=kept)
            report.append(dict(original=str(p.relative_to(job)), pdf=len(groups),
                               kept=kept, blank_candidate=blank,
                               bright_fraction=bright, local_contrast=peak, **correction))
        if args.mode != "multipass":
            break
        if args.replay:
            if pass_no == len(args.replay):
                break
        else:
            event(args, "waiting", choices=["next", "finish"])
            if args.json:
                reply = input().strip().lower()
                if reply not in ("next", "finish"):
                    raise ValueError("Expected next or finish on stdin.")
            else:
                reply = input("Load more sheets and press Enter, or f to finish: ")
                while reply.strip().lower() not in ("", "f"):
                    reply = input("Enter to scan, f to finish: ")
            if reply.strip().lower() in ("f", "finish"):
                break
    (job / "pages.json").write_text(json.dumps(report, indent=2), encoding="utf8")
    used = set()
    total = sum(bool(g) for g in groups)
    for n, group in enumerate(groups, 1):
        if group:
            stem = titles.get(n, f"document-{n:03}")
            name = stem + ".pdf"
            suffix = 1
            while name.casefold() in used:
                suffix += 1
                name = f"{stem} ({suffix}).pdf"
            used.add(name.casefold())
            final_names.append(name)
            event(args, "progress", stage="assemble", document=len(final_names),
                  total_documents=total, filename=name)
            subprocess.run(["img2pdf", "-o", str(pending / name),
                            *map(str, group)], check=True)
    pending.rename(job / "pdf")
    event(args, "completed", pdf=[str(job / "pdf" / name) for name in final_names],
          report=str(job / "pages.json"), sides=len(report), kept_count=sum(r["kept"] for r in report))


def main():
    actions = ("select", "start", "status", "next", "finish")
    if sys.argv[1:2] and sys.argv[1] in actions:
        os.execv(sys.executable, [sys.executable, "/usr/local/lib/scanstation/controller.py", *sys.argv[1:]])
    parser = argparse.ArgumentParser(description=__doc__, epilog="Button commands: " + ", ".join(actions))
    parser.add_argument("--version", action="version", version="ScanStation " + VERSION)
    parser.add_argument("mode", choices=["verify", "sheet", "batch", "multipass"])
    parser.add_argument("--profile", choices=["document", "receipt"])
    parser.add_argument("--config", type=Path, default=CONFIG)
    parser.add_argument("--device", help="SANE device name, or auto")
    parser.add_argument("--replay", action="append", type=Path, default=[], help="replay a directory of PNM sides")
    parser.add_argument("--reference", type=Path, help="optional four-image reference directory")
    parser.add_argument("--filter", action=argparse.BooleanOptionalAction, default=None)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--auto-name", action=argparse.BooleanOptionalAction, default=None)
    parser.add_argument("--quality", type=int, help="JPEG quality from 1 to 95")
    parser.add_argument("--json", action="store_true", help="one JSON event per line")
    args = parser.parse_args()
    try:
        defaults = dict(device=os.getenv("SCANSTATION_DEVICE") or "auto", filter=True, auto_name=True,
                        output="~/scanstation-jobs", quality=76, reference="", profile="document")
        if args.config.exists() or args.config != CONFIG:
            with args.config.open("rb") as conf:
                values = tomllib.load(conf)
            legacy = {"filtrer": "filter", "sortie": "output", "qualite": "quality", "profil": "profile"}
            for key, value in values.items():
                key = legacy.get(key, key)
                if key == "profile" and value == "ticket":
                    value = "receipt"
                if key not in defaults or type(value) is not type(defaults[key]):
                    raise ValueError(f"Invalid configuration setting : {key}")
                defaults[key] = value
        for key, default in defaults.items():
            if getattr(args, key) is None:
                setattr(args, key, default)
        if args.profile not in ("receipt", "document"):
            raise ValueError("Unknown profile")
        args.output = Path(args.output).expanduser()
        args.reference = Path(args.reference).expanduser() if args.reference else None
        if not 1 <= args.quality <= 95:
            raise ValueError("JPEG quality must be between 1 and 95.")
        if args.replay or args.mode == "verify":
            run(args)
        else:
            lockdir = Path(os.environ.get("XDG_STATE_HOME") or Path.home()/".local/state") / "scanstation"
            lockdir.mkdir(parents=True, exist_ok=True)
            with (lockdir / "scanner.lock").open("a") as lock:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    raise ValueError("A scan is already running for this user.") from None
                run(args)
    except (ValueError, OSError, EOFError, KeyboardInterrupt, subprocess.SubprocessError) as exc:
        event(args, "error", message=str(exc) or "Operation interrupted")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
