[Unit]
Description=ScanStation touchscreen console
Wants=scanstation-button.service
After=scanstation-button.service display-manager.service systemd-user-sessions.service
Conflicts=display-manager.service getty@tty8.service

[Service]
User=@ACCOUNT@
SupplementaryGroups=video input
TTYPath=/dev/tty8
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVTDisallocate=yes
EnvironmentFile=-/etc/default/scanstation-kiosk
ExecStartPre=+/usr/bin/chvt 8
ExecStart=/usr/bin/python3 /usr/local/lib/scanstation/kiosk-bridge.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
